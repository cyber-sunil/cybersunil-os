#!/bin/sh
set -e

echo "=== [CyberSunil OS] Executing Chroot Customizations ==="

# 1. Hostname and Identity
echo "cybersunil" > /etc/hostname
cat << 'EOF' > /etc/hosts
127.0.0.1   localhost
127.0.1.1   cybersunil
::1         localhost ip6-localhost ip6-loopback
EOF

# 2. Add i386 Multiarch for 32-bit Windows .EXE compatibility
dpkg --add-architecture i386
apt-get update

# 3. Create Live User 'cybersunil'
if ! id "cybersunil" >/dev/null 2>&1; then
    useradd -m -s /bin/bash -c "CyberSunil User" cybersunil
    echo "cybersunil:cybersunil" | chpasswd
    usermod -aG sudo,audio,video,plugdev,netdev,cdrom cybersunil
fi

# Enable passwordless sudo for live session
echo "cybersunil ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/cybersunil-live
chmod 0440 /etc/sudoers.d/cybersunil-live

# 4. Install CyberSunil Windows Bridge Launcher
cp /tmp/config/wine/cybersunil-wine-launcher.sh /usr/local/bin/cybersunil-wine-launcher
chmod +x /usr/local/bin/cybersunil-wine-launcher

# Register Desktop Entry and MIME Handler for .exe and .msi
cp /tmp/config/wine/cybersunil-wine-launcher.desktop /usr/share/applications/
xdg-mime default cybersunil-wine-launcher.desktop application/x-ms-dos-executable
xdg-mime default cybersunil-wine-launcher.desktop application/x-msi
xdg-mime default cybersunil-wine-launcher.desktop application/x-msdownload

# 5. Setup binfmt_misc for direct kernel execution of .EXE
if [ -d /etc/binfmt.d ]; then
    cp /tmp/config/wine/binfmt-wine.conf /etc/binfmt.d/wine.conf
fi

# 6. Apply Desktop Wallpaper and Branding
mkdir -p /usr/share/backgrounds/cybersunil
cp /tmp/config/desktop/theme/wallpaper.svg /usr/share/backgrounds/cybersunil/wallpaper.svg
cp /tmp/config/desktop/theme/os-release /etc/os-release

# 7. Setup Live Desktop Icons for user
mkdir -p /home/cybersunil/Desktop
cp /tmp/config/desktop/install-cybersunil.desktop /home/cybersunil/Desktop/
cp /tmp/config/desktop/wine-config.desktop /home/cybersunil/Desktop/
chmod +x /home/cybersunil/Desktop/*.desktop
chown -R cybersunil:cybersunil /home/cybersunil/Desktop

# 8. Configure LightDM Auto-Login
mkdir -p /etc/lightdm/lightdm.conf.d
cat << 'EOF' > /etc/lightdm/lightdm.conf.d/80-cybersunil-autologin.conf
[Seat:*]
autologin-user=cybersunil
autologin-user-timeout=0
user-session=xfce
EOF

echo "=== [CyberSunil OS] Customizations Applied Successfully ==="
